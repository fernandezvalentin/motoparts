# Copiá este archivo como .env.local y completá los valores.
# Supabase Dashboard → Project Settings → API

# URL del proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co

# Publishable key (sb_publishable_...) o la anon key clásica. Es pública: la protege RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Secreto compartido con el cron de GitHub Actions (/api/cron/keepalive).
# Generalo con: openssl rand -hex 32
CRON_SECRET=
